  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/serve.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/circuit.test.ts tests/hardware.test.ts tests/lab.test.ts tests/wokwi.test.ts tests/breadboard.test.ts tests/workbench.test.ts tests/workbench-upgrade.test.ts tests/workbench-runtime.test.ts tests/workbench-navigation.test.ts tests/workbench-integrated.test.ts tests/preview.test.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "test:bundle": "node tests/bundled-worker.mjs && node tests/avr-bundled-worker.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:bundle"
  },
  "dependencies": {
